# gia-ops-web(운영앱)과 "같은 Supabase 프로젝트"의 값을 그대로 넣으세요.
# 데이터를 한 곳에서 관리하기 위한 것이므로, 새 프로젝트를 만들면 안 됩니다.
# Supabase 프로젝트 설정 > API Keys 메뉴에서 복사합니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# (선택) 카카오 책 검색 REST API 키 - 한국 책 제목·표지가 가장 잘 나옵니다. 발급이 즉시라
# 네 개 중 가장 먼저 넣기 좋습니다. ISBN 조회와 제목 검색 양쪽에 쓰입니다.
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# (알라딘 Open API 는 2026-10 말에 종료되어 더 쓰지 않습니다.)
KAKAO_REST_API_KEY=

# (선택) 공공데이터포털 국립중앙도서관 ISBN 서지정보 API 키.
# KDC 분류 번호를 주는 유일한 곳이라, 독서 도감 분류가 제대로 채워집니다.
# 발급: https://www.data.go.kr/data/3078982/openapi.do (무료, 신청 즉시 승인)
NL_API_KEY=

# (선택) 책 표지 사진에서 제목을 읽는 기능에 쓰입니다(여러 권 등록 > 📷 표지 찍기).
# 운영앱(gia-ops-web)에 이미 넣어 둔 것과 같은 키를 그대로 쓰면 됩니다.
# 없으면 표지 찍기 버튼이 "아직 켜지지 않았습니다"라고만 알리고, 나머지 기능은 그대로입니다.
# 발급: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
